generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pelicula {
  id         Int      @id @default(autoincrement())
  Title      String
  Year       Int
  Poster     String
  imdbRating Float
  Runtime    Float
  Director   String
  Plot       String
  Images     String
  Actors     String
  cratedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
