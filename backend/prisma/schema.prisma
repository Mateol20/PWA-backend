generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pelicula {
  Id         Int        @id @default(autoincrement())
  Title      String
  Year       Int
  Poster     String
  imdbRating Float
  Runtime    Float
  Director   String
  Plot       String
  Images     String
  Actors     String
  Type       String     @default("movie")
  Genre      String     @default("N/A")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  traducciones pelicula_traduccion[]
  favoritos  Favorito[]
}

model pelicula_traduccion {
  id         Int      @id @default(autoincrement())
  peliculaId Int
  idioma     String
  sinopsis   String
  genero     String?

  pelicula   pelicula @relation(fields: [peliculaId], references: [Id], onDelete: Cascade)

  @@unique([peliculaId, idioma])
}

model Usuario {
  Id          Int        @id @default(autoincrement())
  nombre      String     @unique @default("Admin")
  contrasenia String
  favoritos   Favorito[]
}

model Favorito {
  Id          Int      @id @default(autoincrement())
  idPelicula  Int
  idUsuario   Int
  usuario     Usuario  @relation(fields: [idUsuario], references: [Id])
  pelicula    pelicula @relation(fields: [idPelicula], references: [Id])

  @@unique([idUsuario, idPelicula])
}
