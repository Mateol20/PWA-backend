generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pelicula {
  Id         Int        @id @default(autoincrement())
  Title      String
  Year       Int
  Poster     String
  imdbRating Float
  Runtime    Float
  Director   String
  Plot       String
  Images     String
  Actors     String
  Type       String     @default("movie")
  Genre      String     @default("N/A")
  Trailer    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  favoritos  Favorito[]
}

model Traduccion {
  id      Int    @id @default(autoincrement())
  entidad String // "ui" para interfaz, o el id de película como string para contenido
  clave   String // "inicio", "sinopsis", "genero"
  idioma  String // "es", "en"
  valor   String

  @@unique([entidad, clave, idioma])
}

model User {
  Id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favoritos Favorito[]
}

model Favorito {
  Id      Int      @id @default(autoincrement())
  movieId Int
  userId  Int
  user    User     @relation(fields: [userId], references: [Id])
  movie   pelicula @relation(fields: [movieId], references: [Id])

  @@unique([userId, movieId])
}
