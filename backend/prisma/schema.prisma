
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pelicula {
  Id         Int      @id @default(autoincrement())
  Title      String
  Year       Int
  Poster     String
  imdbRating Float
  Runtime    Float
  Director   String
  Plot       String
  Images     String
  Actors     String
  Type       String   @default("movie")
  Genre      String   @default("N/A")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
